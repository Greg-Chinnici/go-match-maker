# Copy to .env. Used by both docker compose and the server.
DB_PASSWORD=yourpassword
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_NAME=postgres

# For a hosted database, set the full URL instead; it overrides the DB_* values.
# DATABASE_URL=postgres://user:pass@host:5432/dbname?sslmode=require

# TLS mode for the DB_* connection (disable locally, require for most hosts).
# DB_SSLMODE=disable
